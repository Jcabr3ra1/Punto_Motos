{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Punto Moto",
  "version": "0.3.0",
  "identifier": "com.puntomoto.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../frontend"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../frontend"
    },
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Punto Moto",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://localhost:5173; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Jcabr3ra1/Punto_Motos/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3RkI0NjM3QzNGNUEyMUQKUldRZG92WEROMGI3SnpPSmJXUjRTTjNFWXBXeURkT2cveDhFc3REYkxBUHg4VDBWZ0dDRm51TVcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
