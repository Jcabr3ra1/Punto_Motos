# Copia este archivo como .env.local para desarrollar sin Tauri.
# Backend: PUNTO_MOTO_DEBUG=1 python manage.py runserver 127.0.0.1:8765

# URL base de la API (en Tauri la ventana recibirá el puerto real).
VITE_API_BASE_URL=http://127.0.0.1:8765/api/v1

# Credencial del programa (X-Punto-Moto-Token). Déjala vacía en desarrollo:
# sin credencial configurada el backend no la exige.
VITE_APP_TOKEN=
